generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  CLIENTE
  PROFESIONAL
  ADMIN
}

model Ubicacion {
  id            Int           @id @default(autoincrement())
  localidad     String        @db.VarChar(100)
  provincia     String        @db.VarChar(100)
  codigo_postal String        @db.VarChar(20)
  profesionales Profesional[]

  @@unique([localidad, provincia])
  @@map("ubicaciones")
}

model Usuario {
  id              Int          @id @default(autoincrement())
  nombre          String       @db.VarChar(100)
  apellido        String       @db.VarChar(100)
  email           String       @unique @db.VarChar(150)
  contrasena_hash String
  telefono        String?      @db.VarChar(30)
  rol             RolUsuario   @default(CLIENTE)
  activo          Boolean      @default(true)
  creado_en       DateTime     @default(now())
  actualizado_en  DateTime     @default(now()) @updatedAt

  profesional     Profesional?
  resenas         Resena[]

  @@map("usuarios")
}

model Profesional {
  id             Int        @id @default(autoincrement())
  usuario_id     Int        @unique
  ubicacion_id   Int
  descripcion    String?    @db.VarChar(1000)
  matricula      String?    @db.VarChar(50)
  activo         Boolean    @default(true)
  creado_en      DateTime   @default(now())
  actualizado_en DateTime   @default(now()) @updatedAt

  usuario        Usuario    @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  ubicacion      Ubicacion  @relation(fields: [ubicacion_id], references: [id])
  servicios      Servicio[]

  @@map("profesionales")
}

model Oficio {
  id             Int        @id @default(autoincrement())
  nombre         String     @unique @db.VarChar(100)
  descripcion    String?    @db.VarChar(1000)
  activo         Boolean    @default(true)
  creado_en      DateTime   @default(now())
  actualizado_en DateTime   @default(now()) @updatedAt

  servicios      Servicio[]

  @@map("oficios")
}

model Servicio {
  id             Int         @id @default(autoincrement())
  profesional_id Int
  oficio_id      Int
  titulo         String      @db.VarChar(150)
  descripcion    String      @db.VarChar(2000)
  precio         Decimal     @db.Decimal(10, 2)
  activo         Boolean     @default(true)
  creado_en      DateTime    @default(now())
  actualizado_en DateTime    @default(now()) @updatedAt

  profesional    Profesional @relation(fields: [profesional_id], references: [id], onDelete: Cascade)
  oficio         Oficio      @relation(fields: [oficio_id], references: [id])
  resenas        Resena[]

  @@map("servicios")
}

model Resena {
  id             Int      @id @default(autoincrement())
  servicio_id    Int
  usuario_id     Int
  calificacion   Int
  comentario     String?  @db.VarChar(1000)
  activo         Boolean  @default(true)
  creado_en      DateTime @default(now())
  actualizado_en DateTime @default(now()) @updatedAt

  servicio       Servicio @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  usuario        Usuario  @relation(fields: [usuario_id], references: [id])

  @@map("resenas")
}

model Contacto {
  id             Int      @id @default(autoincrement())
  nombre         String   @db.VarChar(120)
  email          String   @db.VarChar(150)
  asunto         String   @db.VarChar(150)
  mensaje        String   @db.VarChar(3000)
  leido          Boolean  @default(false)
  activo         Boolean  @default(true)
  creado_en      DateTime @default(now())
  actualizado_en DateTime @default(now()) @updatedAt

  @@map("contactos")
}
